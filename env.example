# Server-side values only. Never expose SUPABASE_SERVER_KEY to browsers.
SUPABASE_URL=
SUPABASE_SERVER_KEY=

# Set to the exact trusted browser origin only when browser calls are required.
SECURITY_API_CORS_ORIGIN=

# Optional AI advisory; either set all three or leave all three empty.
AI_ANALYZER_ENDPOINT=
AI_ANALYZER_API_KEY=
AI_ANALYZER_MODEL=

# Used by the API's bounded local outbox scheduler; minimum 32 random characters.
OUTBOX_WORKER_TOKEN=

# Optional separate analytics service; set both values together.
DUCKDB_ANALYTICS_URL=
DUCKDB_ANALYTICS_TOKEN=

# Optional internal HoneyDB alert ingestion; set both together.
HONEY_SENSOR_TOKEN=
HONEY_TENANT_ID=77777777-7777-4777-8777-777777777777
