# Server-side values only. Never expose SUPABASE_SERVER_KEY to browsers.
SUPABASE_URL=
SUPABASE_SERVER_KEY=

# Set to the exact trusted browser origin only when browser calls are required.
SECURITY_API_CORS_ORIGIN=

# OpenRouter AI advisory. Keep disabled until the AI phase is explicitly enabled.
# For this project the default model is NVIDIA Nemotron 3 Ultra free.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Used by the API's bounded local outbox scheduler; minimum 32 random characters.
OUTBOX_WORKER_TOKEN=

# Optional separate analytics service; set both values together.
DUCKDB_ANALYTICS_URL=
DUCKDB_ANALYTICS_TOKEN=

# Optional internal HoneyDB alert ingestion; set both together.
HONEY_SENSOR_TOKEN=
HONEY_TENANT_ID=

# Optional internal-only investigation timeline API; disabled when unset.
# Use a random secret of at least 32 characters. Never expose it to clients.
SECURITY_OPS_TOKEN=
